APP_NAME="Agrinas Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------ BASIS DATA
# Skema memakai SQLite. Koneksi `hub` membaca HUB_DB.
DB_CONNECTION=hub
HUB_DB=database/demo/hub-demo.sqlite

# ---------------------------------------------------------------------- SESI
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ---------------------------------------------------------------------- SURAT
MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@contoh.test"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# Integrasi OPSIONAL — biarkan kosong untuk pengembangan lokal.
# Fitur terkait akan melapor "belum dikonfigurasi" dan bagian lain tetap jalan.
# JANGAN pernah menaruh kunci asli di repositori.
# ============================================================================

# Asisten AI (endpoint bergaya OpenAI)
AI_BASE_URL=
AI_MODEL=
AI_MAX_TOKENS=4000
AI_TIMEOUT=60
AI_API_KEY=

# Cloudflare Turnstile (captcha). Kosong = captcha dilewati.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 / S3 untuk berkas unggahan
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_URL=

# OnlyOffice (editor dokumen/spreadsheet)
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=

# Cloudflare Realtime SFU (rapat video)
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=
CF_REALTIME_TURN_KEY=
CF_REALTIME_TURN_SECRET=

# Gerbang WhatsApp (Baileys)
WA_URL=http://127.0.0.1:8092

# SIMKOPDES & AgriConnect (pengembangan integrasi; kosongkan bila tidak dipakai)
SIMKOPDES_API_URL=
SIMKOPDES_PROTO_KEY=
SIMKOPDES_PROTO_IV=
SIMKOPDES_EMAIL=
SIMKOPDES_PASSWORD=
SIMKOPDES_FACILITATOR_ID=
SIMKOPDES_RELAY_URL=
SIMKOPDES_RELAY_KEY=
SIMKOPDES_HELPER_KEY=
AC_MASTER=
AC_USERNAME=
AC_PASSWORD=
LMS_URL=
LMS_EMAIL=
LMS_SANDI=

VITE_APP_NAME="${APP_NAME}"
